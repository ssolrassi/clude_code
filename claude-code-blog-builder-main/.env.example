# ──────────────────────────────────────────────
# .env.example — 이 파일을 .env로 복사한 뒤 실제 값으로 채우세요.
#   cp .env.example .env
# .env 파일은 .gitignore에 등록되어 있어 git에 올라가지 않습니다.
# ──────────────────────────────────────────────

# 네이버 개발자센터 (선택 — 없으면 웹 검색으로 대체)
# 발급: https://developers.naver.com → 애플리케이션 등록 → 검색 API
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret

# Hugging Face 이미지 생성 (필수)
# 무료 발급: https://huggingface.co/settings/tokens → New token (Read 권한)
HF_TOKEN=your_huggingface_token

# 선택: 이미지 모델 override (기본: black-forest-labs/FLUX.1-schnell)
# HF_MODEL=black-forest-labs/FLUX.1-dev

# ──────────────────────────────────────────────
# 브랜드 시스템 (/setup-domain이 자동으로 채움 — 수동 편집도 가능)
# ──────────────────────────────────────────────
BRAND_NAME=쏠라씨
BRAND_BG_COLOR=#F7F6F2
BRAND_FG_COLOR=#1A1A1A
BRAND_ACCENT=#D97A3A
